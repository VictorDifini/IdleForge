<Window x:Class="IdleForge.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configurações" Width="650" Height="590" WindowStartupLocation="CenterOwner" Background="#0D1727" Foreground="White">
 <ScrollViewer><StackPanel Margin="24"><TextBlock Text="Configurações do IdleForge" FontSize="24" FontWeight="SemiBold"/><GroupBox Header="Atualizações locais" Foreground="White" Margin="0,18,0,8" Padding="12"><StackPanel><TextBlock x:Name="VersionLabel"/><TextBox x:Name="UpdateFolderBox" Margin="0,8" IsReadOnly="True"/><WrapPanel><Button Content="Selecionar pasta de versões" Click="ChooseFolder_Click"/><Button Content="Verificar atualizações" Click="Check_Click"/><Button x:Name="UpdateButton" Content="Atualizar agora" Click="Update_Click" IsEnabled="False" Background="#168B6A"/><Button Content="Restaurar versão anterior" Click="Rollback_Click"/></WrapPanel><TextBlock x:Name="UpdateStatus" Foreground="#9DB1C9" TextWrapping="Wrap" Margin="4,8"/></StackPanel></GroupBox><GroupBox Header="Inicialização" Foreground="White" Margin="0,8" Padding="12"><StackPanel><CheckBox x:Name="RestoreSessionCheck" Content="Restaurar última sessão automaticamente" Foreground="White" Margin="4"/><CheckBox x:Name="RestoreProfilesCheck" Content="Reabrir somente os perfis anteriores" Foreground="White" Margin="4"/><CheckBox x:Name="RestoreLayoutCheck" Content="Restaurar layout, grade, foco e janela" Foreground="White" Margin="4"/><CheckBox x:Name="RememberScriptsCheck" Content="Lembrar preferências dos scripts e painéis" Foreground="White" Margin="4"/></StackPanel></GroupBox><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14"><Button Content="Cancelar" IsCancel="True"/><Button Content="Salvar" Click="Save_Click" IsDefault="True" Background="#168B6A"/></StackPanel></StackPanel></ScrollViewer>
</Window>
