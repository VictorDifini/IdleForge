<Window x:Class="IdleForge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IdleForge" Width="1400" Height="900" MinWidth="980" MinHeight="620" Background="#080D18" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#101827"/><SolidColorBrush x:Key="Muted" Color="#8FA1B8"/><SolidColorBrush x:Key="Accent" Color="#38D39F"/>
  <Style TargetType="Button"><Setter Property="Background" Value="#172338"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="3"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  <Style x:Key="TopNavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="15"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#26364E"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0B1220"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#26364E"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#AFC0D5"/><Setter Property="Margin" Value="0,3"/><EventSetter Event="Expanded" Handler="SidebarGroup_Changed"/><EventSetter Event="Collapsed" Handler="SidebarGroup_Changed"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="286" MinWidth="54" MaxWidth="390"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource Panel}"><Grid>
   <StackPanel x:Name="CompactSidebar" Visibility="Collapsed"><TextBlock Text="IF" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Margin="0,14"/><Button Content="▦" ToolTip="Exibir todas as contas" Click="ShowAllAccounts_Click" HorizontalContentAlignment="Center"/><Button Content="↻" ToolTip="Recarregar contas" Click="ReloadAccounts_Click" HorizontalContentAlignment="Center"/><Button Content="≋" ToolTip="Userscripts" Click="ShowScripts_Click" HorizontalContentAlignment="Center"/><Button Content="◫" ToolTip="Downloads" Click="ShowDownloads_Click" HorizontalContentAlignment="Center"/><Button Content="⚙" ToolTip="Configurações e atualizações" Click="Settings_Click" HorizontalContentAlignment="Center"/></StackPanel>
   <DockPanel x:Name="FullSidebar" Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="IDLEFORGE" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="22"/><TextBlock Text="GAME OPERATIONS" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,1,0,8"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="3,8"><TextBlock x:Name="EngineStatus" Text="WebView2 · aguardando" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="MetricsStatus" Foreground="#7FD6BA" FontSize="10" TextWrapping="Wrap" Margin="0,3"/><TextBlock Text="Dados locais · sem telemetria externa" Foreground="#53657C" FontSize="9"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Expander x:Name="AccountsGroup" Header="CONTAS" IsExpanded="True"><StackPanel><Button Content="＋ Adicionar jogo" Click="AddGame_Click" Background="#168B6A"/><Button Content="↻ Recarregar contas" Click="ReloadAccounts_Click"/><Button Content="⏸ Suspender conta atual" Click="Suspend_Click"/><Button Content="▶ Retomar conta atual" Click="Resume_Click"/><ListBox x:Name="ProfilesList" SelectionMode="Single" Background="Transparent" BorderThickness="0" PreviewMouseLeftButtonUp="ProfilesList_PreviewMouseLeftButtonUp"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="#152136"/><Setter Property="Margin" Value="0,2"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#176B72"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Padding="9" Background="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=Background}" CornerRadius="5"><StackPanel><TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Clique para ampliar · perfil isolado" Foreground="#9DB1C9" FontSize="10"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Expander>
     <Expander x:Name="ViewGroup" Header="VISUALIZAÇÃO" IsExpanded="True"><StackPanel><Button Content="▦ Exibir todas as contas" Click="ShowAllAccounts_Click" Background="#176B72"/><Button Content="⚙ Configurar grade" Click="ConfigureGrid_Click"/><CheckBox x:Name="KeepOthersVisibleCheck" Content="Miniaturas ativas" Foreground="White" Margin="8,5" IsChecked="True" Checked="LayoutOption_Changed" Unchecked="LayoutOption_Changed"/><CheckBox x:Name="ExpandOnClickCheck" Content="Clique amplia" Foreground="White" Margin="8,5" Checked="LayoutOption_Changed" Unchecked="LayoutOption_Changed"/><WrapPanel><Button Content="− Zoom" Click="ZoomOut_Click"/><Button Content="＋ Zoom" Click="ZoomIn_Click"/><ComboBox x:Name="ColumnsBox" Width="82" Height="30" Margin="3" SelectionChanged="LayoutOption_Changed"><ComboBoxItem Content="Auto" IsSelected="True"/><ComboBoxItem Content="2 col." Tag="2"/><ComboBoxItem Content="3 col." Tag="3"/><ComboBoxItem Content="4 col." Tag="4"/></ComboBox></WrapPanel></StackPanel></Expander>
     <Expander x:Name="ScriptsGroup" Header="USERSCRIPTS" IsExpanded="True"><StackPanel><Button Content="≋ Abrir Scripts e painéis" Click="ShowScripts_Click"/><Button Content="⌁ Instalar arquivo .user.js" Click="InstallScript_Click"/><Button Content="🌐 Instalar por URL" Click="InstallScriptUrl_Click"/><Button Content="⬆ Atualizar script" Click="UpdateScript_Click"/><Button Content="↶ Histórico e restaurar" Click="RestoreScript_Click"/><Button Content="◫ Downloads" Click="ShowDownloads_Click"/></StackPanel></Expander>
     <Expander x:Name="PerformanceGroup" Header="DESEMPENHO" IsExpanded="True"><StackPanel><ComboBox x:Name="PerformanceModeBox" Margin="3" Height="31" SelectionChanged="PerformanceMode_Changed"><ComboBoxItem Content="Máximo" Tag="Maximum"/><ComboBoxItem Content="Equilibrado" Tag="Balanced" IsSelected="True"/><ComboBoxItem Content="Econômico" Tag="Economy"/></ComboBox><CheckBox x:Name="ShowMetricsCheck" Content="CPU, RAM e processos" Foreground="White" Margin="8,5" Checked="MetricsOption_Changed" Unchecked="MetricsOption_Changed"/></StackPanel></Expander>
     <Expander x:Name="SystemGroup" Header="SISTEMA"><StackPanel><Button Content="⚙ Configurações e atualizações" Click="Settings_Click"/><Button Content="◫ Diagnósticos e downloads" Click="ShowDownloads_Click"/></StackPanel></Expander>
    </StackPanel></ScrollViewer>
   </DockPanel>
  </Grid></Border>
  <GridSplitter Grid.Column="1" Width="5" Background="#1D2A3D" HorizontalAlignment="Stretch" DragCompleted="SidebarSplitter_DragCompleted"/>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#0D1523"><Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Grid.Column="0" x:Name="SidebarToggleButton" Style="{StaticResource TopNavigationButton}" Content="☰" ToolTip="Recolher ou expandir menu" Click="ToggleSidebar_Click"/>
   <Button Grid.Column="1" x:Name="BackButton" Style="{StaticResource TopNavigationButton}" Content="←" ToolTip="Voltar" Click="Back_Click" IsEnabled="False"/>
   <Button Grid.Column="2" x:Name="ForwardButton" Style="{StaticResource TopNavigationButton}" Content="→" ToolTip="Avançar" Click="Forward_Click" IsEnabled="False"/>
   <Button Grid.Column="3" Style="{StaticResource TopNavigationButton}" Content="↻" ToolTip="Recarregar página" Click="Reload_Click"/>
   <Button Grid.Column="4" x:Name="ReturnToGameButton" Style="{StaticResource TopNavigationButton}" Content="⌂" ToolTip="Voltar ao jogo" Click="ReturnToGame_Click" IsEnabled="False" Background="#168B6A"/>
   <Button Grid.Column="5" Style="{StaticResource TopNavigationButton}" Content="↗" ToolTip="Abrir no navegador" Click="OpenExternal_Click"/>
   <TextBox x:Name="AddressBox" Grid.Column="6" Margin="5,4" Padding="8,4" MinWidth="180" VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown"/>
   <Button Grid.Column="7" x:Name="TopGridButton" Style="{StaticResource TopNavigationButton}" Width="42" Content="▦" ToolTip="Exibir grade" Click="ShowAllAccounts_Click" Background="#176B72"/>
  </Grid></Border><Grid Grid.Row="1" x:Name="BrowserArea"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◇" Foreground="{StaticResource Accent}" FontSize="64" HorizontalAlignment="Center"/><TextBlock Text="Seu centro de operações para jogos web" Foreground="White" FontSize="22"/><TextBlock Text="Adicione qualquer URL HTTP/HTTPS e crie uma sessão isolada." Foreground="{StaticResource Muted}" Margin="0,10"/></StackPanel></Grid><Border Grid.Row="2" Background="#0D1523"><TextBlock x:Name="FooterStatus" Text="Pronto" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="10" Margin="10,0"/></Border></Grid>
 </Grid>
</Window>
