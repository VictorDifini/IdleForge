<Window x:Class="IdleForge.App.InstallUrlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Instalar userscript por URL" Width="640" Height="190" WindowStartupLocation="CenterOwner" Background="#0E1726">
 <StackPanel Margin="22"><TextBlock Text="URL HTTPS do .user.js ou página compatível" Foreground="White" FontSize="18"/><TextBox x:Name="UrlBox" Margin="0,14" Padding="10" Background="#080D18" Foreground="White"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Margin="5" Padding="14,8" Click="Cancel_Click"/><Button Content="Baixar para revisão" Margin="5" Padding="14,8" Background="#168B6A" Foreground="White" Click="Continue_Click"/></StackPanel></StackPanel>
</Window>
