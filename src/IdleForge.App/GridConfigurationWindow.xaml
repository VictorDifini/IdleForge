<Window x:Class="IdleForge.App.GridConfigurationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configurar grade" Width="430" Height="520" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#0D1727">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Contas exibidas na grade" Foreground="White" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Esta seleção não altera a conta aberta nem reinicia sessões." Foreground="#91A4BC" Margin="0,5,0,14" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button Content="Selecionar todas" Click="SelectAll_Click" Padding="10,5" Margin="0,0,8,8"/><Button Content="Limpar" Click="Clear_Click" Padding="10,5" Margin="0,0,0,8"/></StackPanel></StackPanel>
    <ListBox x:Name="AccountsList" Grid.Row="1" Background="#111D30" BorderBrush="#283B56" Padding="6"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected,Mode=TwoWay}" Foreground="White" Padding="8" FontSize="14"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cancelar" IsCancel="True" Padding="14,7" Margin="0,0,8,0"/><Button Content="Salvar" Click="Save_Click" IsDefault="True" Padding="18,7" Background="#168B6A"/></StackPanel>
  </Grid>
</Window>
