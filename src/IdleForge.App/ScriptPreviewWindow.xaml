<Window x:Class="IdleForge.App.ScriptPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Revisar userscript" Width="900" Height="700" WindowStartupLocation="CenterOwner" Background="#0E1726">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="TitleText" Foreground="White" FontSize="24" FontWeight="SemiBold"/><Border Grid.Row="1" x:Name="RiskBorder" CornerRadius="5" Padding="10" Margin="0,12"><TextBlock x:Name="RiskText" Foreground="White" TextWrapping="Wrap"/></Border>
  <StackPanel Grid.Row="2"><TextBlock x:Name="PermissionsText" Foreground="#CBD6E5" TextWrapping="Wrap"/><CheckBox x:Name="BroadConnectCheck" Foreground="#FFCF70" Margin="0,8" Visibility="Collapsed">Autorizo explicitamente @connect * (acesso amplo à Internet; redes locais continuam bloqueadas)</CheckBox><CheckBox x:Name="MainWorldCheck" Foreground="#FFCF70" Margin="0,8" Visibility="Collapsed"><TextBlock TextWrapping="Wrap">Autorizo @sandbox raw no mundo principal. O script poderá acessar e modificar diretamente a página e os objetos internos do jogo.</TextBlock></CheckBox></StackPanel>
  <TextBlock Grid.Row="3" Text="Código-fonte — revise antes de permitir a instalação" Foreground="#A8B5C7" Margin="0,4,0,8"/><TextBox Grid.Row="4" x:Name="SourceBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#080D18" Foreground="#CED8E6" BorderBrush="#24344D"/>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" Padding="16,8" Margin="5" Click="Cancel_Click"/><Button Content="Entendo e desejo instalar" Padding="16,8" Margin="5" Background="#168B6A" Foreground="White" Click="Install_Click"/></StackPanel>
 </Grid>
</Window>
