<Window x:Class="IdleForge.App.ScriptVersionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Restaurar userscript" Width="650" Height="460" WindowStartupLocation="CenterOwner" Background="#0D1727" Foreground="White">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Histórico de versões" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="A versão atual será arquivada antes da restauração." Foreground="#91A4BC" Margin="0,5,0,12"/></StackPanel><DataGrid x:Name="VersionsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Background="#111D30" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="Script" Binding="{Binding ScriptName}" Width="2*"/><DataGridTextColumn Header="Versão" Binding="{Binding Version.Version}" Width="*"/><DataGridTextColumn Header="Arquivada em" Binding="{Binding Version.ArchivedAt}" Width="2*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" IsCancel="True" Padding="12,7" Margin="0,0,8,0"/><Button Content="Restaurar" Click="Restore_Click" IsDefault="True" Padding="14,7" Background="#168B6A"/></StackPanel></Grid>
</Window>
