<Window x:Class="IdleForge.App.ScriptManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Userscripts e painéis" Width="1080" Height="650" MinWidth="880" MinHeight="520" WindowStartupLocation="CenterOwner" Background="#0E1726" Foreground="White">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Central de userscripts" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ProfileLabel" Foreground="#8FA1B8" Margin="0,3,0,14"/></StackPanel><Button Content="Verificar atualizações" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#168B6A" Click="CheckUpdates_Click"/></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ListBox x:Name="ScriptsList" SelectionChanged="ScriptsList_SelectionChanged" Background="#080D18" Foreground="White"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" Margin="2" Background="#152136"><StackPanel><TextBlock Text="{Binding Metadata.Name}" FontWeight="SemiBold"/><TextBlock Foreground="#8FA1B8"><Run Text="v"/><Run Text="{Binding Metadata.Version}"/><Run Text=" · ativo nesta conta: "/><Run Text="{Binding Enabled}"/></TextBlock></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="1"><TextBlock x:Name="ExecutionStatus" Foreground="#E5B567" TextWrapping="Wrap" Margin="4,8"/><WrapPanel><Button Content="Ativar" Click="Enable_Click"/><Button Content="Desativar" Click="Disable_Click"/><Button Content="Aplicar e recarregar" Click="ApplyReload_Click" Background="#168B6A"/><Button Content="Desinstalar desta conta" Click="Uninstall_Click" Background="#7F3040"/><Button Content="Desinstalar em contas…" Click="UninstallProfiles_Click" Background="#7F3040"/></WrapPanel></StackPanel>
   </Grid>
   <GridSplitter Grid.Column="1" Width="8" Background="#26364E" HorizontalAlignment="Stretch"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="PanelSummary" Text="Selecione um script." Foreground="#AFC0D5" Margin="8"/>
    <DataGrid Grid.Row="1" x:Name="PanelsGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#080D18" Foreground="White"><DataGrid.Columns><DataGridTextColumn Header="Painel" Binding="{Binding Label}" Width="2*"/><DataGridTextColumn Header="Detecção" Binding="{Binding Detection}" Width="*"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="*"/><DataGridTextColumn Header="Preferência" Binding="{Binding Preference}" Width="*"/></DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="2" Margin="4,10"><Button Content="Mostrar painel" Click="Show_Click"/><Button Content="Ocultar painel" Click="Hide_Click"/><Button Content="Detectar novamente" Click="Discover_Click"/><Button Content="Seleção manual" Click="Manual_Click"/><Button Content="Restaurar" Click="Restore_Click"/></WrapPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8"><TextBlock Text="Preferência:" VerticalAlignment="Center"/><ComboBox x:Name="PreferenceBox" Width="180" Margin="8,0" SelectionChanged="PreferenceBox_SelectionChanged"><ComboBoxItem Content="Sempre mostrar" Tag="AlwaysShow"/><ComboBoxItem Content="Iniciar oculto" Tag="StartHidden"/><ComboBoxItem Content="Lembrar último estado" Tag="RememberLastState"/></ComboBox><TextBlock x:Name="CompatibilityLabel" Foreground="#E5B567" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
   </Grid>
  </Grid>
  <Button Grid.Row="2" Content="Fechar" Padding="18,8" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click"/>
 </Grid>
</Window>
